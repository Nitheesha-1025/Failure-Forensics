# Copy to .env beside docker-compose.yml before `docker compose up`.

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# LLM provider: zen | cloudflare | nvidia | openai
FORENSICS_LLM_PROVIDER=zen

# OpenCode Zen (Anthropic SDK → POST .../v1/messages)
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=claude-fable-5-1

# Cloudflare Workers AI (when FORENSICS_LLM_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# NVIDIA NIM (when FORENSICS_LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/muse-glimmer-30b

# OpenAI (when FORENSICS_LLM_PROVIDER=openai)
FORENSICS_OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8090
