# Copy to .env and fill in. Never commit .env.

# --- Application database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://forensics:forensics@localhost:5432/forensics

# --- Authentication (required for /v1/auth/*) ---
# At least 32 characters; do not use the placeholder value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APPLICATION_SECRET=

# --- Document uploads (Phase 3) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- LLM provider (pipeline steps + root-cause judge) ---
# auto = OpenCode Zen if OPENCODE_ZEN_API_KEY is set, else Cloudflare, else OpenAI
# zen | cloudflare | nvidia | openai (aliases: anthropic, opencode → zen)
FORENSICS_LLM_PROVIDER=auto

# OpenCode Zen (Anthropic Messages API via Anthropic SDK)
# Base URL must include /v1 — SDK calls POST .../v1/messages
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=claude-fable-5-1

# Cloudflare Workers AI (Free plan: 10,000 Neurons/day)
# Create an API token with Workers AI Read at https://dash.cloudflare.com/profile/api-tokens
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right column)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Default model on Free tier: @cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Parallel judge LLM calls during root-cause analysis (default 1 avoids rate limits)
# FORENSICS_JUDGE_CONCURRENCY=1

# NVIDIA NIM (when FORENSICS_LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/muse-glimmer-30b
# Muse Glimmer: answer + reasoning share max_tokens; floor raises small stage limits safely
NVIDIA_OUTPUT_TOKEN_FLOOR=1024
NVIDIA_OUTPUT_TOKEN_CEILING=8192
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95

# OpenAI (when FORENSICS_LLM_PROVIDER=openai or auto with only this key set)
FORENSICS_OPENAI_API_KEY=
FORENSICS_EXTRACTION_MODEL=gpt-4o-mini
FORENSICS_CLASSIFICATION_MODEL=gpt-4o-mini
FORENSICS_SUMMARIZATION_MODEL=gpt-4o-mini
FORENSICS_JUDGE_MODEL=gpt-4o

# --- Trace storage (SQLite + JSON files; unchanged in Phase 2) ---
FORENSICS_DB_PATH=./forensics.sqlite3
FORENSICS_TRACES_DIR=./traces

# --- API server ---
FORENSICS_API_HOST=0.0.0.0
FORENSICS_API_PORT=8090
CORS_ORIGINS=http://localhost:5173
